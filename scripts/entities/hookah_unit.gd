class_name HookahUnit
extends RefCounted
## M12: один кальян в мире (цвет, шланг и кто его держит). Раньше всё это лежало полями в GarageWorld
## (кальян был один); теперь у каждого кальяна своё состояние, чтобы два гостя могли курить одновременно.

## Цвет кальяна (взят с полки; такой же несут, ставят на стол и подают гостю).
var color := Color("#22b8ff")
## Линия шланга, нарисованная этим кальяном.
var hose: HoseLine = null
## Шланг: концы плавно едут к целевым точкам (колбэки возвращают координаты Entities).
var start_fn := Callable()
var end_fn := Callable()
var aim_fn := Callable()
var cover_fn := Callable()
var cover_id := ""
## Начало шланга плавно едет (только когда мастер тянет его к клапану); иначе приклеено к кальяну.
var start_smooth := false
## Вид ручки шланга (случайный при выборе кальяна).
var handle_style := 0
## Кто держит конец шланга (игрок или гость), null — шланг лежит.
var holder: Node2D = null
## Кальян стоит на столе гостя (а не у стола для кальянов и не в руках).
var at_guest := false
## Мастер раскуривает кальян, пока гость не взял шланг.
var warming_up := false
## Мундштук гостя, которому подан этот кальян (из коробки на столе).
var guest_piece := Color("#e29a2e")
## Место, на столе которого стоит кальян (null — кальян у стола для кальянов или в руках).
var station: GuestStation = null
