class_name GuestStation
extends RefCounted
## M12: место гостя за столом: стол, кальян на нём, клетки для кальянщика и (для основного места) стул игрока.
## Основное место (s1) описано в раскладке гаража; второе (s2) собирается из купленных малого стола и стула.

const MAIN_ID := "s1"
const EXTRA_ID := "s2"
const EXTRA2_ID := "s3"
## s4 занято (второе место за главным столом), поэтому дополнительные столы: s2, s3, s5…s8.
const EXTRA_IDS: Array[String] = ["s2", "s3", "s5", "s6", "s7", "s8"]
## Второе место за главным столом: на стуле кальянщика (когда он на нём не сидит).
const MAIN2_ID := "s4"

var id := ""
## Объект-стол в мире (он же интеракция: подсказки «Покурить», «Заменить угли» и т.д.).
var table_id := ""
## Объект-кальян на этом столе.
var hookah_id := ""
## uid стола в системе мебели (у основного места пусто): у одного стола может быть два места.
var table_uid := ""
## Клетка, откуда кальянщик подаёт кальян и принимает заказ.
var serve_cell := Vector2i(-1, -1)
## Клетка, откуда меняют угли (для основного места — рядом с лотком с углями).
var coal_cell := Vector2i(-1, -1)
## Клетка стула игрока (только основное место: кальянщик может присесть и покурить с гостем).
var seat_cell := Vector2i(-1, -1)
## Клетка стула гостя и его поза.
var guest_cell := Vector2i(-1, -1)
var seat_emoji := "🧘‍♂️"
var seat_faces_left := false
## Кальян, который сейчас стоит на столе (null — стол пуст).
var unit: HookahUnit = null
## Гость, который сидит за этим столом ("" — никого).
var guest_id := ""
## Спутник гостя с соседнего места (компания): сидит здесь, но кальян и заказ — у гостя другого места ("" — никого).
var companion_id := ""


func can_player_sit() -> bool:
	return seat_cell.x >= 0
